---
import { sitePath } from '../lib/paths';
import type { CollectionEntry } from 'astro:content';
import EventVisual from './EventVisual.astro';
import { orderedSessions, accessLabel, statusLabel } from '../lib/catalog';
import { formatDate, searchKey } from '../lib/dates.mjs';
const { event, referenceDay, hidden = false }: { event: CollectionEntry<'events'>; referenceDay: string; hidden?: boolean } = Astro.props;
const info = event.data;
const dates = orderedSessions(event).map(session => session.date);
const initial = dates.find(date => date >= referenceDay) ?? dates.at(-1)!;
const time = info.sessions.find(session => session.date === initial)?.times.join(' · ');
const priceLabel = info.price && info.price.length <= 35 ? info.price : accessLabel[info.access];
---
<article class="event-card" hidden={hidden} data-event data-dates={dates.join(',')} data-category={info.category} data-access={info.access} data-search={searchKey([info.title, info.venue, ...info.artists].join(' '))}>
  <a class="card-link" href={sitePath(`agenda/${event.id}/`)}>
    <EventVisual info={info} />
    <div class="card-body">
      <div class="card-meta"><span>{info.category}</span><time data-event-date datetime={initial}>{formatDate(initial)}</time></div>
      <h3>{info.title}</h3>
      <p>{info.venue}{time && <span class="card-session-time">{time}</span>}</p>
      <div class="card-bottom"><span class="badge" data-free={info.access === 'free'}>{info.status === 'scheduled' ? priceLabel : statusLabel[info.status]}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
    </div>
  </a>
</article>

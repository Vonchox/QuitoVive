---
import EventVisual from './EventVisual.astro';
import { sitePath } from '../lib/paths';
import { formatDate } from '../lib/dates.mjs';
const { plan, hidden = false } = Astro.props;
const { date } = plan;
const period = (time: string) => time < '12:00' ? 'Mañana' : time < '18:00' ? 'Tarde' : 'Noche';
---
<article class="event-card plan-card" hidden={hidden} data-plan data-date={date} data-times={plan.times.join(',')} data-cost={plan.cost ?? ''}>
  <div class="plan-gallery" aria-label="Fotos de las actividades sugeridas">
    {plan.items.map(item => <a class="plan-photo" href={sitePath(`agenda/${item.event.id}/`)} aria-label={`Ver ${item.event.data.title}`}>
      <EventVisual info={item.event.data} />
      <span>{item.time} · {item.event.data.category}</span>
    </a>)}
  </div>
  <div class="card-body">
    <div class="card-meta"><time datetime={date}>{formatDate(date)}</time><span>{plan.items.length} {plan.items.length === 1 ? 'EVENTO' : 'EVENTOS'}</span></div>
    <h2>{plan.title}</h2>
    <p>{plan.description}</p>
    <ol class="itinerary">
      {plan.items.map((item, index) => <li><span class="step-number">{String(index + 1).padStart(2, '0')}</span><div>
        <strong>{period(item.time)} · <time>{item.time}</time> · {item.event.data.venue}</strong>
        <a href={sitePath(`agenda/${item.event.id}/`)}>{item.event.data.title} ↗</a>
        <p>{item.event.data.summary}</p>
        <a class="map-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${item.event.data.venue}, Quito, Ecuador`)}`} target="_blank" rel="noopener noreferrer">Cómo llegar en Maps ↗</a>
      </div></li>)}
      <li class="food-stop"><span class="step-number">＋</span><div><strong>Complemento · algo rico entre actividades</strong>
        <p>{plan.food.note} Es opcional y no forma parte del precio de las entradas.</p>
        <a class="map-link" href={plan.food.url} target="_blank" rel="noopener noreferrer">{plan.food.name} · ver en Maps ↗</a>
      </div></li>
    </ol>
    <div class="plan-cost">
      <span>{plan.cost === undefined ? 'Entradas por confirmar' : plan.cost === 0 ? 'Eventos gratuitos' : `Entradas USD ${plan.cost.toFixed(2)} / persona`}</span>
      <strong data-plan-total>{plan.cost === undefined ? 'Consultar' : `USD ${(plan.cost * 2).toFixed(2)} para 2`}</strong>
    </div>
    <p class="plan-footnote">Las horas son los inicios publicados. El margen entre actividades es orientativo: confirma su duración y el traslado. Comida y transporte se presupuestan aparte. OMI es una sugerencia opcional; su cercanía no está verificada.</p>
  </div>
</article>


---
import { sitePath } from '../lib/paths';
import type { CollectionEntry } from 'astro:content';
import Poster from './Poster.astro';
const { post }: { post: CollectionEntry<'posts'> } = Astro.props;
---
<article class="event-card">
  <a class="card-link" href={sitePath(`blog/${post.id}/`)}>
    <Poster art={post.data.art} />
    <div class="card-body">
      <div class="card-meta">{post.data.label}</div>
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
      <div class="card-bottom"><span>Leer la nota</span><span class="card-arrow" aria-hidden="true">↗</span></div>
    </div>
  </a>
</article>

---
import { sitePath } from '../../lib/paths';
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Poster from '../../components/Poster.astro';
import { postList } from '../../lib/catalog';
import { formatDate } from '../../lib/dates.mjs';
export async function getStaticPaths() {
  return (await postList()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Shell title={`${post.data.title} | QuitoVive`} description={post.data.description} active="blog">
  <section class="page-head detail-head blog-head"><div class="wrap detail-top">
    <div><a class="text-link back" href={sitePath('blog/')}>← Volver al blog</a><p class="eyebrow">{post.data.label}</p><h1>{post.data.title}</h1><p>{post.data.description}</p></div>
    <Poster art={post.data.art} />
  </div></section>
  <div class="wrap section"><article class="prose"><p class="byline">Redacción QuitoVive · <time datetime={post.data.date}>{formatDate(post.data.date)}</time></p><Content /></article></div>
</Shell>

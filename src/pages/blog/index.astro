---
import Shell from '../../layouts/Shell.astro';
import PostCard from '../../components/PostCard.astro';
import { postList } from '../../lib/catalog';
const posts = await postList();
---
<Shell title="Blog cultural | QuitoVive" active="blog">
  <section class="page-head blog-head"><div class="wrap"><p class="eyebrow">02 / EL BLOG DE QUITOVIVE</p><h1>Quito en palabras<span>.</span></h1><p>Guías para salir, artistas que escuchar y espacios que vale la pena recorrer con calma.</p></div></section>
  <section class="wrap section"><h2 class="visually-hidden">Notas recientes</h2><div class="cards">{posts.map(post => <PostCard post={post} />)}</div></section>
</Shell>

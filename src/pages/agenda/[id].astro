---
import { sitePath } from '../../lib/paths';
import Shell from '../../layouts/Shell.astro';
import EventVisual from '../../components/EventVisual.astro';
import { eventAction } from '../../lib/event-links.mjs';
import { eventList, orderedSessions, accessLabel, statusLabel } from '../../lib/catalog';
import { formatDate } from '../../lib/dates.mjs';
export async function getStaticPaths() {
  return (await eventList()).map(event => ({ params: { id: event.id }, props: { event } }));
}
const { event } = Astro.props;
const info = event.data;
const sessions = orderedSessions(event);
const action = eventAction(info);
---
<Shell title={`${info.title} | QuitoVive`} description={info.summary} active="agenda">
  <section class="page-head detail-head">
    <div class="wrap detail-top">
      <div><a class="text-link back" href={sitePath('agenda/')}>← Volver a la agenda</a><p class="eyebrow">{info.category} / {statusLabel[info.status]}</p><h1>{info.title}</h1><p>{info.summary}</p></div>
      <EventVisual info={info} eager />
    </div>
  </section>
  <div class="wrap section detail-grid">
    <div class="detail-content">
      {info.description && info.description.length > 0 && <section class="event-description"><h2>De qué se trata</h2>{info.description.map(paragraph => <p>{paragraph}</p>)}</section>}
      <section><h2>Fechas y horarios</h2><ul class="sessions">
        {sessions.map(({ date, times }) => <li><time datetime={date}>{formatDate(date)}</time><span>{times.length ? times.join(' · ') : 'Horario por confirmar'}</span></li>)}
      </ul><p class="muted">Hora local de Quito.</p></section>
      {info.artists.length > 0 && <section><h2>Quién participa</h2><ul class="artist-list">{info.artists.map(artist => <li>{artist}</li>)}</ul></section>}
    </div>
    <aside class="info-box" aria-labelledby="info-title">
      <h2 id="info-title">Antes de ir</h2>
      <dl>
        <dt>Lugar</dt><dd>{info.venue} · Quito <a class="text-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(info.venue + ', Quito')}`}>Cómo llegar ↗</a></dd>
        <dt>Organiza</dt><dd>{info.organizer}</dd>
        <dt>Entrada</dt><dd>{info.price ?? accessLabel[info.access]}{info.accessNote && <p>{info.accessNote}</p>}</dd>
        <dt>Aforo</dt><dd>{info.capacity ? `${info.capacity} personas` : 'Aforo no publicado'}</dd>
        {info.accessibility && <><dt>Accesibilidad</dt><dd>{info.accessibility}</dd></>}
      </dl>
      {action && info.status === 'scheduled' && <a class="button" href={action.url}>{action.label} <span aria-hidden="true">↗</span></a>}
      <p class="source-note"><small>Actualizado el <time datetime={info.contentSource?.checked ?? info.source.checked}>{formatDate(info.contentSource?.checked ?? info.source.checked)}</time>.</small><a class="text-link" href={sitePath(`fuentes/#evento-${event.id}`)}>Datos y créditos</a></p>
      {info.image && <p class="image-credit">Imagen de {info.image.credit}.</p>}
    </aside>
  </div>
</Shell>
